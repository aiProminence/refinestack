# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Public application URL used for authentication redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=
INVITATION_FROM_EMAIL=RefineStack <invites@example.com>

# Observation providers (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SERPAPI_API_KEY=
PROVIDER_TIMEOUT_MS=60000
SERPAPI_COST_PER_SEARCH_USD=

# Server-only application security
# 32 random bytes encoded as 64 hex characters or base64url
APP_ENCRYPTION_KEY=
WORKER_SECRET=
CRON_SECRET=
API_CURSOR_SECRET=
WEBHOOK_SIGNING_PEPPER=

# Optional per-token API limits
API_RATE_LIMIT_READ_PER_MINUTE=60
API_RATE_LIMIT_RUN_PER_MINUTE=10
API_RATE_LIMIT_EXPORT_PER_MINUTE=10

# Credentialed browser release gate (dedicated non-production fixture only)
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ANALYST_EMAIL=
E2E_ANALYST_PASSWORD=
E2E_VIEWER_EMAIL=
E2E_VIEWER_PASSWORD=
E2E_RUN_ID=
E2E_API_TOKEN=
